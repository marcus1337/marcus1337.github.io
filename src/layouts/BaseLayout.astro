---
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/BlogHeader.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  index?: boolean;
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
}

const { index = false, ...metadata } = Astro.props;

const contentFade = {
  old: { name: 'astroFadeOut', duration: '130ms', easing: 'ease-in', fillMode: 'both' },
  new: { name: 'astroFadeIn', duration: '220ms', delay: '130ms', easing: 'ease-out', fillMode: 'both' },
};
const pageTransition = { forwards: contentFade, backwards: contentFade };
---

<!doctype html>
<html lang="en" data-theme="dark" transition:name="root" transition:animate={pageTransition}>
  <head>
    <BaseHead {...metadata} />
    <ClientRouter fallback="swap" />
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('blog-theme');
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.dataset.theme = savedTheme;
        }
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <BlogHeader />
    <main id="main-content" class:list={['site-main', { 'index-page': index }]} tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
