<button class="theme-toggle" type="button" data-theme-toggle aria-label="Light mode" hidden>Light mode</button>

<script>
  function updateLabels() {
    const label = document.documentElement.dataset.theme === 'light' ? 'Dark mode' : 'Light mode';
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      button.textContent = label;
      button.setAttribute('aria-label', label);
      button.hidden = false;
    }
  }

  // Delegation keeps the switch working when Astro swaps the page body.
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) return;
    const theme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem('blog-theme', theme); } catch {}
    updateLabels();
  });

  document.addEventListener('astro:before-swap', (event) => {
    event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme ?? 'dark';
  });
  document.addEventListener('astro:page-load', updateLabels);
  updateLabels();
</script>
