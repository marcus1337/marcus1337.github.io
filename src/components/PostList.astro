---
import { formatDate, postUrl, publicationDay, type BlogPost } from '../lib/blog';
interface Props { posts: BlogPost[] }
const { posts } = Astro.props;
---
<ol class="post-list">
  {posts.map((post) => (
    <li class="post-entry">
      <time datetime={publicationDay(post)}>{formatDate(post.data.pubDate)}</time>
      <div class="entry-content">
        <h3><a href={postUrl(post)}><span>{post.data.title}</span><span class="entry-arrow" aria-hidden="true">→</span></a></h3>
        {post.data.description && <p>{post.data.description}</p>}
      </div>
    </li>
  ))}
</ol>
