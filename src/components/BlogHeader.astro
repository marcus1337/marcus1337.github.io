---
const isPostList = Astro.url.pathname.replace(/\/$/, '') === '/blog';
const href = isPostList ? '/' : '/blog/';
const label = isPostList ? 'Main site' : 'All posts';
---

<header class="blog-bar">
  <a class="back-link" href={href} data-astro-reload={isPostList ? '' : undefined}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M19 12H5m6-6-6 6 6 6" />
    </svg>
    <span>{label}</span>
  </a>
  <span class="bar-caption" aria-hidden="true">marcus1337 / writing</span>
</header>
