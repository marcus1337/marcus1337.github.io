---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import EditorialMotion from '../../components/EditorialMotion.astro';
import { BLOG_DESCRIPTION } from '../../consts';
import { getPublishedPosts } from '../../lib/blog';
import '../../styles/blog.css';
const posts = await getPublishedPosts();
---
<BaseLayout title="Blog" description={BLOG_DESCRIPTION} index>
  <header class="journal-intro">
    <h1 class="journal-title">Writing<span class="title-dot">.</span></h1>
    <p class="lede">{BLOG_DESCRIPTION}</p>
  </header>
  <section class="entries-section" aria-labelledby="entries-heading">
    <div class="entries-heading">
      <h2 id="entries-heading">Posts</h2>
      <span>{String(posts.length).padStart(2, '0')} {posts.length === 1 ? 'post' : 'posts'}</span>
    </div>
    {posts.length ? <PostList posts={posts} /> : <p>No posts yet.</p>}
  </section>
  <EditorialMotion />
</BaseLayout>
